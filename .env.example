GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3-32b

GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.5-flash-lite-preview-09-2025

LLM_PROVIDER_ORDER=groq,gemini
LLM_MAX_ATTEMPTS=8
APP_SECRET_KEY=change-me-for-production

# Local defaults are storage/shl_recommender.sqlite3 and storage/evidence.
# On Hugging Face Spaces, enable persistent storage and use:
# PERSISTENT_DIR=/data/shl-recommender
PERSISTENT_DIR=
DATABASE_PATH=
EVIDENCE_DIR=

CATALOG_PATH=shl_product_catalog.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_SENTENCE_TRANSFORMER=false
